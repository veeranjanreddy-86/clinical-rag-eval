# Copy to .env and adjust. Never commit a real .env file.

# --- Core (prefix CRAG_) ---
CRAG_DOCS_DIR=data/docs
CRAG_CHUNKS_PATH=artifacts/chunks.jsonl
CRAG_TOP_K=4
CRAG_CHUNK_SIZE=80
CRAG_CHUNK_OVERLAP=20
CRAG_MIN_SCORE=4.0
CRAG_MIN_QUERY_COVERAGE=0.4
CRAG_LOG_LEVEL=INFO

# --- Retriever: bm25 (default) | embeddings ---
CRAG_RETRIEVER=bm25
# CRAG_EMBEDDING_BACKEND=sentence-transformers   # or: openai
# CRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Generator: offline (default) | openai | azure_openai ---
CRAG_GENERATOR=offline
# CRAG_LLM_MODEL=gpt-4o-mini

# --- Optional provider credentials (leave empty for offline use) ---
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01
